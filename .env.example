# Prisma connection URL for local Postgres from docker compose.
DATABASE_URL="postgresql://payping:payping@localhost:5432/payping?schema=public"
# Direct URL used by Prisma schema operations on local Postgres.
DIRECT_URL="postgresql://payping:payping@localhost:5432/payping?schema=public"

# Redis connection for the local BullMQ reminder queue.
REDIS_URL="redis://localhost:6379"

# Enable local adapters that never call Meta or Razorpay.
DEMO_MODE=true
# Enable the one-minute reminder sequence for local demos.
DEMO_TIME_COMPRESSION=true
# HMAC secret used only by the signed fake demo payment event.
DEMO_WEBHOOK_SECRET="payping-demo-webhook-secret"
# Verification token for the demo Meta webhook handshake.
META_WEBHOOK_VERIFY_TOKEN="payping-demo-meta-verify-token"
# Base URL used by E2E scripts to reach the local app.
DEMO_BASE_URL="http://localhost:3000"
# Public app URL embedded in local demo payment links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Used only when DEMO_MODE is false and real Razorpay webhook verification is enabled.
RAZORPAY_WEBHOOK_SECRET=

# Local organization reminder send hour in its timezone.
REMINDER_SEND_HOUR_LOCAL=10
# Maximum concurrent reminder jobs for the local worker.
WORKER_CONCURRENCY=5
# Global WhatsApp worker rate limit, even though delivery is mocked in demo mode.
WA_RATE_LIMIT_PER_SECOND=40

# Role email displayed in the site footer.
CONTACT_EMAIL=team@example.com
# Deployed Google Apps Script web-app URL ending in /exec.
LEADS_SHEET_WEBHOOK_URL=
# Shared secret checked by the Apps Script endpoint.
LEADS_SHEET_SECRET=
# Optional Resend API key for lead notifications and webhook-failure fallback.
RESEND_API_KEY=
# Optional team inbox for lead notifications.
LEAD_NOTIFY_EMAIL=
# Optional verified Resend sender.
RESEND_FROM=
